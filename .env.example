# Portfonia — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ---- App ----
APP_ENV=development
APP_SECRET_KEY=<openssl rand -hex 32>
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---- Database (Postgres in docker-compose) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfonia_dev
DB_USER=portfonia
DB_PASSWORD=<random-hex>

# ---- Redis (docker-compose) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- LLM via OpenRouter ----
# All LLM traffic (primary + low-cost) is routed through a single OpenRouter
# account. Model IDs follow OR's `vendor/model` convention.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=<sk-or-v1-...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model: holdings-aware report generation
PRIMARY_LLM_MODEL=anthropic/claude-sonnet-4.6

# Low-cost model: non-personalized search-instruction generation
# Candidates: anthropic/claude-haiku-4.5 | openai/gpt-oss-20b
LOW_COST_LLM_MODEL=anthropic/claude-haiku-4.5

# Provider pinning for structured extraction. OpenRouter routes one model id
# across providers of differing precision; aggressive-quantization resellers
# degrade JSON/schema compliance. Comma-separated, highest priority first.
# Adjust to the chosen model's actual OpenRouter providers.
OPENROUTER_PROVIDER_ORDER=Anthropic
OPENROUTER_ALLOW_FALLBACKS=true

# ---- Search ----
TAVILY_API_KEY=<tvly-...>
TAVILY_DAILY_BUDGET=10

# ---- Email (Resend HTTP API) ----
# Sender domain must be verified in Resend dashboard.
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM=Portfonia <noreply@<verified-sender-domain>>
EMAIL_REPLY_TO=noreply@<verified-sender-domain>

# ---- Developer identity (Ring 0 single-user mode) ----
# Generate once: `uuidgen | tr A-Z a-z`. Seed script writes this UUID into the
# `holdings.user_id` column so the rest of the stack can stay multi-user-ready
# without an auth layer.
DEV_USER_ID=<uuid>
DEV_USER_EMAIL=<dev-inbox>
