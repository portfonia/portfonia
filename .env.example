# Portfonia — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ---- App ----
APP_ENV=development
APP_SECRET_KEY=<openssl rand -hex 32>
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ---- Database (Postgres in docker-compose) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfonia_dev
DB_USER=portfonia
DB_PASSWORD=<random-hex>

# ---- Redis (docker-compose) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- LLM via OpenRouter ----
# All LLM traffic (primary + low-cost) is routed through a single OpenRouter
# account. Model IDs follow OR's `vendor/model` convention.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=<sk-or-v1-...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Non-Jade Pass 2 and regenerate: deny, unpinned (#793).
PRIMARY_LLM_MODEL=anthropic/claude-haiku-5.5
# PRIMARY_LLM_REASONING_EFFORT=medium

# Report translation: deny, unpinned, flex with one standard-tier fallback (#793).
LOW_COST_LLM_MODEL=openai/gpt-6-luna
# LOW_COST_LLM_REASONING_EFFORT=none

# The only model used for structured (JSON schema-required) extraction —
# currently holdings parsing only (issue #78). Was google/gemma-4-31b-it
# (correctly handles Chinese entity recognition — broker names, fund types,
# wmf vs cash — and was the only model verified at 100%/210/210 on the
# PC611-homepage eval case set, tested 2026-06-03), moved to
# openai/gpt-5.6-luna (issue #84, 2026-08-06): the gemma-4-31b-it pin to
# OpenInference's bf16 endpoint was itself the bottleneck on real-sized
# files (371s worst case on 30 rows). gpt-5.6-luna measured 10.9-13.8s on
# the same file with a full manual accuracy audit (30/30 correct) — one
# manual run, not yet a 210/210-scale eval. Routed with
# reasoning_effort=none (app/services/holding_parser.py) — this specific
# model defaults reasoning to "medium"; changing STRUCTURED_LLM_MODEL to a
# model without a "none" reasoning-effort tier requires revisiting that.
STRUCTURED_LLM_MODEL=openai/gpt-5.6-luna

# Optional provider preference for callers that request pinning.
# Pass 2 and translation do not use this order (#793).
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
# Every LLM call excludes data-collecting providers, with no exception (#793).
OPENROUTER_DATA_COLLECTION=deny

# ---- Search ----
TAVILY_API_KEY=<tvly-...>
EXA_API_KEY=
EXA_MONTHLY_USD_LIMIT=5.00
TAVILY_DAILY_BUDGET=10

# ---- Forward calendar (#1) ----
# Optional. Free key from https://fredaccount.stlouisfed.org/apikeys — powers the
# §2.5 macro release dates (CPI/PPI/NFP/Retail/PCE/GDP/UMich). When unset, the
# forward calendar falls back to FOMC (hardcoded) + earnings (yfinance) only.
FRED_API_KEY=<fred-32-char-key>

# ---- Email (Resend HTTP API) ----
# Sender domain must be verified in Resend dashboard.
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM=Portfonia <noreply@<verified-sender-domain>>
EMAIL_REPLY_TO=noreply@<verified-sender-domain>
# Automatic waitlist invitation letters per ET day (issue #672). Default 10; 0 pauses.
# WAITLIST_AUTO_INVITE_DAILY_LIMIT=10

# ---- Daily DB backup to OCI Object Storage (issue #106) ----
# Optional — empty namespace disables the scheduled task (local dev default).
# In production, an unset namespace fails the backup task loudly rather than
# silently skipping (this is the only DB restore safety net). Retention is
# enforced by the bucket's Object Lifecycle Policy, not this app — see
# Obsidian Portfonia Environment Config.md.
BACKUP_OCI_NAMESPACE=<oci-object-storage-namespace>
BACKUP_OCI_BUCKET=portfonia-db-backups

# ---- Ops API token channel (issue #129 Ring 1 stage B, checkpoint B2) ----
# Bearer secret guarding /admin/* routes — deliberately independent of the
# user auth system (must still work if that system itself is what's broken).
# Required in every environment, no unset state. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Production generates and stores its own value — never copy this from a dev
# .env.local. _PREV is optional, for a no-downtime rotation window.
ADMIN_API_TOKEN=<generate-with-secrets.token_urlsafe(32)>
# ADMIN_API_TOKEN_PREV=<previous-token-during-rotation>

# ---- Non-account Admin root actor (issue #672) ----
# Generate once: `uuidgen | tr A-Z a-z`. Used as the creator of Ops and
# automatic invites; never create a persistent users row for this actor.
# Represents info@portfonia.com. DEV_USER_EMAIL remains for historical seed fixtures.
ADMIN_ID=<uuid>
DEV_USER_EMAIL=<dev-inbox>

# ---- Hosted Auth (Supabase, Ring 1-B checkpoint B4) ----
# Dashboard names (2026): Publishable key / Secret key. Map those onto
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (aliases
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY also accepted).
# Do not store the JWT signing secret — verification is JWKS ES256/RS256.
# SUPABASE_PROJECT_HOST is the hostname of SUPABASE_URL (no scheme). Caddy
# reverse-proxies auth.portfonia.com here; docker compose fails closed if
# it is unset (do not use an empty default).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_HOST=<project-ref>.supabase.co
SUPABASE_ANON_KEY=<sb_publishable_...>
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_...>

# ---- Frontend auth (Ring 1-B checkpoint B5) ----
# Baked into the frontend build (docker-compose.yml's frontend.build.args,
# frontend/Dockerfile) — NEXT_PUBLIC_* vars are statically inlined by
# `next build`, there is no runtime override. NEXT_PUBLIC_SUPABASE_ANON_KEY
# reuses SUPABASE_ANON_KEY above (same publishable key, safe to expose to
# the browser — that's what "publishable" means). SUPABASE_PUBLIC_AUTH_URL
# is deliberately NOT SUPABASE_URL: the browser must go through the
# auth.portfonia.com Caddy reverse proxy (mainland-reachability workaround,
# §2.7/§6.10 of the Ring 1-B design doc), not straight to *.supabase.co.
# Optional — defaults to https://auth.portfonia.com if unset.
SUPABASE_PUBLIC_AUTH_URL=https://auth.portfonia.com

# Paddle API environment: production or sandbox; unset disables payments.
PADDLE_ENVIRONMENT=<production-or-sandbox>
# Server-only Paddle API key for the matching environment.
PADDLE_API_KEY=<pdl_live_or_pdl_sdbx_key>
# Public Paddle.js client token for the matching environment.
PADDLE_CLIENT_SIDE_TOKEN=<live_or_test_token>
# Server-only secret for the Paddle notification destination.
PADDLE_WEBHOOK_SECRET=<notification-secret>
# JSON map from one-time Paddle price IDs to positive credit amounts.
PADDLE_CREDIT_PACKS='{"pri_example10":"10","pri_example20":"20"}'
