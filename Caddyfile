portfonia.com, www.portfonia.com {
	reverse_proxy frontend:3000
}

api.portfonia.com {
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy backend:8000
	}
}

# Auth reverse-proxy (Ring 1-B decision point 2). Browser talks to our
# domain; Caddy forwards to the hosted Auth origin. Do not log request
# bodies on this route (passwords transit here). Do not enable caching.
auth.portfonia.com {
	reverse_proxy https://{$SUPABASE_PROJECT_HOST} {
		header_up Host {$SUPABASE_PROJECT_HOST}
	}
	header {
		Cache-Control "no-store"
	}
}

# Vigil frontend (issue #453 handoff follow-up). Reaches vigil-frontend
# over the portfonia-vigil-public network — a separate, narrowly scoped
# external network from portfonia-vigil-internal (issue #452), which is
# reserved for the backend-to-backend identity-check hop and stays off
# this one. Only caddy (here) and vigil-frontend attach to this network.
vigil.portfonia.com {
	reverse_proxy vigil-frontend:3000
}
