# Vigil — environment template
# Copy to vigil/.env (compose) or vigil/.env.local (host tests). NEVER commit either file.
# All keys are VIGIL_-prefixed. Unprefixed Portfonia DB/key/queue names are ignored.

VIGIL_APP_ENV=production

VIGIL_DB_HOST=vigil-postgres
VIGIL_DB_PORT=5432
VIGIL_DB_NAME=vigil
VIGIL_DB_USER=vigil
VIGIL_DB_PASSWORD=change-me

VIGIL_REDIS_HOST=vigil-redis
VIGIL_REDIS_PORT=6379
VIGIL_REDIS_DB=1
VIGIL_REDIS_KEY_PREFIX=vigil
VIGIL_CELERY_QUEUE_PREFIX=vigil

VIGIL_OBJECT_BUCKET=vigil-objects
VIGIL_OWNER_AUTH_SUBJECT=replace-with-auth-subject

VIGIL_KEK=replace-with-32-plus-byte-kek
VIGIL_KEK_VERSION=v1
VIGIL_NOTIFICATION_KEY=replace-with-distinct-notification-key
VIGIL_NONCE_KEY=replace-with-nonce-key
VIGIL_ALTCHA_HMAC_KEY=replace-with-altcha-key

VIGIL_IDENTITY_SERVICE_TOKEN=replace-with-identity-token
VIGIL_OPS_API_TOKEN=replace-with-ops-token
VIGIL_RESEND_API_KEY=replace-with-resend-key

# JWT issuer (hosted Auth /auth/v1) and Portfonia container URL on the
# shared portfonia-vigil-internal network. Not public Caddy.
VIGIL_AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
VIGIL_PORTFONIA_INTERNAL_BASE_URL=http://backend:8000

# Incomplete integration must not be armable.
VIGIL_DISPATCH_ENABLED=false
VIGIL_RELEASE_ENABLED=false
VIGIL_ARMING_ENABLED=false
